generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Drum {
  id          Int     @id @default(autoincrement())
  nama        String  @unique
  kapasitasKg Int     @map("kapasitas_kg")
  status      String  @default("aktif")
  batches     Batch[]

  @@map("drums")
}

model Batch {
  id           Int          @id @default(autoincrement())
  drumId       Int          @map("drum_id")
  tanggalMulai DateTime     @map("tanggal_mulai") @db.Date
  totalHari    Int          @default(14) @map("total_hari")
  beratKg      Decimal?     @map("berat_kg") @db.Decimal(5, 1)
  drum         Drum         @relation(fields: [drumId], references: [id], onDelete: Cascade)
  readings     Reading[]
  pressEvents  PressEvent[]
  gateEvents   GateEvent[]
  alerts       Alert[]
  events       Event[]

  @@index([drumId, tanggalMulai])
  @@map("batches")
}

model Reading {
  id         BigInt   @id @default(autoincrement())
  batchId    Int      @map("batch_id")
  waktu      DateTime @db.Timestamptz(3)
  suhu       Decimal  @db.Decimal(4, 1)
  kelembapan Int?
  tekanan    Decimal? @db.Decimal(5, 1)
  gas        Int?
  label      String?
  batch      Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, waktu])
  @@map("readings")
}

model PressEvent {
  id        BigInt   @id @default(autoincrement())
  batchId   Int      @map("batch_id")
  waktu     DateTime @db.Timestamptz(3)
  gayaTekan Decimal  @map("gaya_tekan") @db.Decimal(6, 1)
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, waktu])
  @@map("press_events")
}

model GateEvent {
  id      BigInt   @id @default(autoincrement())
  batchId Int      @map("batch_id")
  waktu   DateTime @db.Timestamptz(3)
  tercapai Boolean
  batch   Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, waktu])
  @@map("gate_events")
}

model Alert {
  id      BigInt   @id @default(autoincrement())
  batchId Int      @map("batch_id")
  waktu   DateTime @db.Timestamptz(3)
  jenis   String
  pesan   String
  batch   Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, waktu])
  @@map("alerts")
}

model Event {
  id      BigInt   @id @default(autoincrement())
  batchId Int      @map("batch_id")
  waktu   DateTime @db.Timestamptz(3)
  judul   String
  status  String
  tone    String
  batch   Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, waktu])
  @@map("events")
}
