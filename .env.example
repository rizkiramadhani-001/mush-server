# PostgreSQL 16+ (TCP 5432). Sesuaikan user/password dengan instance Anda.
DATABASE_URL="postgresql://mush:mush@localhost:5432/mush?schema=public"

HOST=0.0.0.0
PORT=8080

# Dipisah koma. Gunakan * hanya untuk pengembangan.
CORS_ORIGIN=http://localhost:8000,http://localhost:5173

# Zona waktu untuk menghitung hari fermentasi dan label jam.
APP_TZ=Asia/Jakarta
